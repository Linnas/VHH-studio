# Copy to .env and fill in. .env is gitignored and never sent to the browser.
TAMARIND_API_KEY=
TAMARIND_BASE_URL=https://app.tamarind.bio/api
POLL_MS=15000

# Optional local RFD4-Proteina executor (WSL2 / Linux)
LOCAL_RFD4_ENABLED=1
LOCAL_RFD4_DISTRO=Ubuntu-24.04
LOCAL_RFD4_REPO=/home/matwings/rfd4-local/repo
LOCAL_RFD4_VENV=/home/matwings/rfd4-local/.venv
